{
  "name": "clinic",
  "private": true,
  "version": "0.2.0",
  "description": "Multi-tenant clinic management platform, hospital-ready (v2)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace apps/api",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate:prod --workspace apps/api",
    "platform:create-admin": "npm run platform:create-admin --workspace apps/api --",
    "platform:reset-mfa": "npm run platform:reset-mfa --workspace apps/api --",
    "platform:create-admin:prod": "node apps/api/dist/cli/create-platform-admin.js",
    "platform:reset-mfa:prod": "node apps/api/dist/cli/reset-platform-mfa.js"
  }
}
