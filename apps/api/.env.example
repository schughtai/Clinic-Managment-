# Copy to .env and fill in. Never commit the real file.
# In development you do not need any of this: `npm run dev` supplies safe local values.

NODE_ENV=production
PORT=3001

# The application connects as a restricted role named clinic_app. Row-level security applies to it.
# Migrations connect as an administrator. Use two different logins.
DATABASE_URL=postgres://clinic_app:CHANGE_ME@db-host:5432/clinic
ADMIN_DATABASE_URL=postgres://admin_user:CHANGE_ME@db-host:5432/clinic

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_HOURS=12

# The address people use to open the web app. Must be https in production.
ALLOWED_ORIGINS=https://clinic.example.com
# Number of reverse proxies in front of the API (so rate limits see real client addresses).
TRUST_PROXY=1

# Creating a new clinic needs this code. Leave empty to turn clinic signup off.
SIGNUP_CODE=

# Photos of handwritten notes. Must be a persistent disk, not temporary storage.
UPLOAD_DIR=/var/data/clinic-uploads

# Optional. Turns on AI reading of handwriting and note tidy-up. Each clinic still has to switch it on.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

LOG_LEVEL=info
