# Copy to .env and fill in. Never commit the real file.
# In development you do not need any of this: `npm run dev` supplies safe local values.

NODE_ENV=production
PORT=3001

# The application connects as the restricted role clinic_app. Row-level security applies to it.
# The API refuses to start if this role is a superuser or can bypass row-level security.
DATABASE_URL=postgres://clinic_app:CHANGE_ME@db-host:5432/clinic
# Migrations and operator commands (creating the Super Admin) connect as an administrator.
ADMIN_DATABASE_URL=postgres://admin_user:CHANGE_ME@db-host:5432/clinic

SESSION_HOURS=12

# 32 random bytes as hex. Encrypts authenticator secrets. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# The address people use to open the web app. Must be https in production. The first entry is used in links.
ALLOWED_ORIGINS=https://clinic.example.com
# Number of reverse proxies in front of the API (so rate limits see real client addresses).
TRUST_PROXY=1

# Serve the built web app from the API (single service, same origin). Path to apps/web/dist.
WEB_DIST_DIR=../web/dist

LOG_LEVEL=info
